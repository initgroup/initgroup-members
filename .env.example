# Copy this file to .env and fill in environment-specific values.
# Never commit .env or credentials.

# Application
APP_NAME=INIT Members
LOG_LEVEL=INFO
# Comma-separated exact HTTP(S) origins. Wildcards and URL paths are not supported.
INIT_ALLOWED_ORIGINS=

# System Oracle DB: local or cloud
DB_MODE=local

# Local Oracle DB
DB_USER_LOC=
DB_PASSWORD_LOC=
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=

# Oracle Cloud DB
DB_USER_CLD=
DB_PASSWORD_CLD=
DB_DSN_CLD=
DB_WALLET_PATH=
DB_WALLET_PASSWORD=

# thin is recommended. Set a client path only for thick mode.
DB_ORACLE_MODE=thin
DB_CLIENT_PATH=
DB_CONNECT_TIMEOUT=10
DB_RETRY_COUNT=1
DB_RETRY_DELAY=1

# System DB connection pool
DB_POOL_MIN=1
DB_POOL_MAX=6
DB_POOL_INCREMENT=1
DB_POOL_WAIT_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_WARN_SECONDS=3
DB_POOL_IDLE_TIMEOUT_SECONDS=300
DB_POOL_MAX_LIFETIME_SECONDS=3600
DB_POOL_PING_INTERVAL_SECONDS=60
DB_POOL_PING_TIMEOUT_MS=5000
DB_CALL_TIMEOUT_MS=60000

# Login session and cookie
INIT_SESSION_COOKIE_NAME=init_session
INIT_SESSION_TTL_SECONDS=28800
INIT_AUTH_QUERY_TIMEOUT_MS=5000
# Use Y for production HTTPS. Blank keeps the local-development auto default.
INIT_COOKIE_SECURE=
# Supported values: lax or strict
INIT_COOKIE_SAMESITE=lax

# Authentication rate limiting (process-local)
INIT_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
INIT_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
INIT_SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5
INIT_AUTH_RATE_LIMIT_MAX_CLIENTS=2048

# First administrator and public operator contact
INIT_ADMIN_KEY=
INIT_ADMIN_CONTACT_NAME=
INIT_ADMIN_CONTACT_EMAIL=
INIT_ADMIN_CONTACT_PHONE=

# Notice attachment size per file, in bytes
APP_NOTICE_FILE_MAX_BYTES=10485760
